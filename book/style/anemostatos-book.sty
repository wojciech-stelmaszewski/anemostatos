% ---------------------------------------------------------------- figures ---
% Figure with a side caption in the margin (text-width graphic).
\newcommand{\simfig}[4][]{% [width] {file} {caption} {label}
  \begin{figure}[tbp]
    \ifstrempty{#1}{\includegraphics[width=\textwidth]{#2}}{\includegraphics[width=#1]{#2}}%
    \sidecaption{#3\label{#4}}
  \end{figure}}
% Full-width figure (text + margin), caption below.
\newcommand{\widefig}[3]{% {file} {caption} {label}
  \begin{figure}[tbp]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \includegraphics[width=\linewidth]{#1}
      \caption{#2}\label{#3}
    \end{adjustwidth}
  \end{figure}}
\newcommand{\widefigH}[3]{% same, placed here
  \begin{figure}[h!]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \includegraphics[width=\linewidth]{#1}
      \caption{#2}\label{#3}
    \end{adjustwidth}
  \end{figure}}
% An app screenshot, full width, with a thin frame.
\newcommand{\screen}[4][]{% [trim l b r t in px of 3200x2000] {file} {caption} {label}
  \begin{figure}[tbp]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \ifstrempty{#1}{\includegraphics[width=\linewidth]{screens/#2}}%
        {\adjincludegraphics[width=\linewidth, trim={#1}, clip]{screens/#2}}%
      \caption{#3}\label{#4}
    \end{adjustwidth}
  \end{figure}}
\newenvironment{fullwidth}{\begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}}{\end{adjustwidth}}
\setlength{\abovecaptionskip}{6pt}
\renewcommand{\floatpagefraction}{0.75}
\renewcommand{\topfraction}{0.85}
\renewcommand{\textfraction}{0.12}
\setcounter{topnumber}{3}

% A crop of an app screenshot in the margin (e.g. the lesson panel).
\newcommand{\marginscreen}[4]{% {trim l b r t} {file} {caption} {label}
  \marginnote{\adjincludegraphics[width=\marginparwidth, trim={#1}, clip, valign=t]{screens/#2}\par\vspace{2pt}%
  \captionsetup{type=figure}\caption{#3}\label{#4}}}
% A small figure in the margin, top-aligned with the line where it is called.
\newcommand{\marginfig}[3]{\marginnote{\includegraphics[width=\marginparwidth,valign=t]{#1}\par\vspace{2pt}%
  \captionsetup{type=figure}\caption{#2}\label{#3}}}
\newcommand{\marginphoto}[2]{\marginnote{\includegraphics[width=\marginparwidth,valign=t]{photos/#1}\par\vspace{2pt}%
  {\sffamily\scriptsize\color{sepia}#2 \hyperref[credit:#1]{\textsc{credit}}}}}

