% ---------------------------------------------------------------- figures ---
% Figure with a side caption in the margin (text-width graphic).
% The graphic fills the text column; the caption stands beside it in the margin, its last line
% level with the foot of the graphic. Being part of the float, it cannot collide with a note.
\newcommand{\sidecapfig}[3]{% {content} {caption} {label}
  \begin{figure}[tbp]
    \noindent\makebox[\textwidth][l]{%
      \begin{minipage}[b]{\textwidth}#1\end{minipage}%
      \hspace{\marginparsep}%
      \begin{minipage}[b]{\marginparwidth}\captionsetup{style=sidecaption,skip=0pt}%
        \caption{#2}\label{#3}\end{minipage}}%
  \end{figure}}
\newcommand{\simfig}[4][]{% [width] {file} {caption} {label}
  \sidecapfig{\ifstrempty{#1}{\includegraphics[width=\linewidth]{#2}}{\includegraphics[width=#1]{#2}}}{#3}{#4}}
% Full-width figure (text + margin), caption below.
\newcommand{\widefig}[3]{% {file} {caption} {label}
  \begin{figure}[tbp]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \includegraphics[width=\linewidth]{#1}
      \caption{#2}\label{#3}
    \end{adjustwidth}
  \end{figure}}
\newcommand{\widefigH}[3]{% same, placed here
  \begin{figure}[h!]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \includegraphics[width=\linewidth]{#1}
      \caption{#2}\label{#3}
    \end{adjustwidth}
  \end{figure}}
% An app screenshot, full width, with a thin frame.
\newcommand{\screen}[4][]{% [trim l b r t in px of 3200x2000] {file} {caption} {label}
  \begin{figure}[tbp]
    \begin{adjustwidth}{0pt}{-\dimexpr\marginparsep+\marginparwidth\relax}
      \ifstrempty{#1}{\includegraphics[width=\linewidth]{screens/#2}}%
        {\adjincludegraphics[width=\linewidth, trim={#1}, clip]{screens/#2}}%
      \caption{#3}\label{#4}
    \end{adjustwidth}
  \end{figure}}
