% Definition — deep blue rule
\newtcolorbox{definition}[1]{base, colback=bluesoft, borderline west={2.2pt}{0pt}{deepblue},
  title={\boxlabel{deepblue}{DEFINITION}\hspace{0.8em}{\sffamily\small\bfseries #1}}, attach title to upper,
  after title={\par\smallskip}}

% Key idea — accent rule
\newtcolorbox{keyidea}[1][]{base, colback=accentsoft, borderline west={2.2pt}{0pt}{accent},
  title={\boxlabel{accent}{KEY IDEA}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}

% Result (a boxed formula or statement)
\newtcolorbox{result}[1][]{base, colback=white, colframe=accent, boxrule=0.6pt, arc=2pt,
  title={\boxlabel{accent}{RESULT}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}

% Worked example
\newtcolorbox{example}[1][]{base, colback=white, colframe=hair, boxrule=0.6pt,
  title={\boxlabel{muted}{WORKED EXAMPLE}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}

% Watch out
\newtcolorbox{watchout}[1][]{base, colback=warnsoft, borderline west={2.2pt}{0pt}{warn},
  title={\boxlabel{warn}{WATCH OUT}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}

% Where this leads — the thread from a lesson into the later parts of the course
\newtcolorbox{lookahead}[1][]{base, colback=bluesoft, colframe=deepblue, boxrule=0.6pt, arc=2pt,
  title={\boxlabel{deepblue}{WHERE THIS LEADS}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}

% In Anemostatos — styled like the app itself
\newcommand{\appmark}{\tikz[baseline=-0.1em]{\draw[accent, line width=1.2pt, line cap=round] (0,0)--(0.62em,0.62em) (0,0.62em)--(0.62em,0);}}
\newtcolorbox{inapp}[1][]{base, colback=night, colupper=nighttext, coltitle=nighttext, arc=3pt,
  fontupper={\sffamily\small\linespread{1.18}\selectfont\raggedright},
  title={\appmark\hspace{0.5em}\boxlabel{nightmuted}{IN ANEMOSTATOS}\ifstrempty{#1}{}{\hspace{0.8em}{\color{nighttext}\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip},
  before upper app={\let\src\srcnight\let\param\paramnight\let\ui\uinight\let\key\keynight}}

% Try this — the app's own orange-bordered box
\newtcolorbox{trythis}[1][]{base, colback=accentsoft!55, colframe=accent, boxrule=0.7pt, arc=3pt,
  title={\boxlabel{accent}{TRY THIS}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip}}
