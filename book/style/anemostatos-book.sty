% ---------------------------------------------------------------- boxes -----
\tcbset{
  base/.style={enhanced, breakable, coltitle=ink, boxrule=0pt, arc=1.5pt, outer arc=1.5pt,
    left=10pt, right=10pt, top=7pt, bottom=7pt, before skip=12pt, after skip=12pt,
    fontupper=\normalsize, parbox=false},
  % short boxes are never cut in two by a page break
  whole/.style={breakable=false},
  label/.style={title={#1}, attach title to upper, coltitle=ink,
    fonttitle={\sanscaps\scriptsize}, after title={\par\smallskip}},
  % Paragraphs inside a box are set apart by a little space and never indented. These styles must
  % come after `attach title to upper', which replaces what stands before the upper part.
  blockpars/.style={before upper app={\setlength{\parindent}{0pt}\setlength{\parskip}{3.5pt plus 1pt}}},
  flushfirst/.style={after title={\par\smallskip}, blockpars},
  flushfirstmed/.style={after title={\par\medskip}, blockpars},
}
\newcommand{\boxlabel}[2]{{\color{#1}\sanscaps\scriptsize #2}}

% Definition — deep blue rule
\newtcolorbox{definition}[1]{base, colback=bluesoft, borderline west={2.2pt}{0pt}{deepblue},
  title={\boxlabel{deepblue}{DEFINITION}\hspace{0.8em}{\sffamily\small\bfseries #1}}, attach title to upper,
  flushfirst}

% Key idea — accent rule
\newtcolorbox{keyidea}[1][]{base, whole, colback=accentsoft, borderline west={2.2pt}{0pt}{accent},
  title={\boxlabel{accent}{KEY IDEA}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}

% Result (a boxed formula or statement)
\newtcolorbox{result}[1][]{base, whole, colback=white, arc=0pt, outer arc=0pt, frame hidden,
  borderline north={0.8pt}{0pt}{accent}, borderline south={0.8pt}{0pt}{accent},
  left=0pt, right=0pt, top=7pt, bottom=7pt,
  title={\boxlabel{accent}{RESULT}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}

% Worked example
% Numbered within the lesson, so that \ref to an example gives its own number, not the section's.
\newcounter{example}[chapter]
\renewcommand{\theexample}{\lessonlabel.\arabic{example}}
\newtcolorbox{examplebox}[1]{base, colback=white, arc=0pt, outer arc=0pt, frame hidden,
  borderline west={1pt}{0pt}{faint!55},
  left=13pt, right=0pt, top=1pt, bottom=1pt, before skip=13pt, after skip=13pt,
  title={\boxlabel{muted}{WORKED EXAMPLE \theexample}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}
\NewDocumentEnvironment{example}{O{}}{\refstepcounter{example}\begin{examplebox}{#1}}{\end{examplebox}}

% Watch out
\newtcolorbox{watchout}[1][]{base, whole, colback=warnsoft, borderline west={2.2pt}{0pt}{warn},
  title={\boxlabel{warn}{WATCH OUT}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}

% Theorem — a statement with its hypotheses, proven here or cited with its source
\newcounter{theorem}[chapter]
\renewcommand{\thetheorem}{\lessonlabel.\arabic{theorem}}
\newtcolorbox{theorembox}[1]{base, colback=white, arc=0pt, outer arc=0pt, frame hidden,
  borderline north={0.8pt}{0pt}{deepblue}, borderline south={0.8pt}{0pt}{deepblue},
  left=0pt, right=0pt, top=7pt, bottom=7pt,
  title={\boxlabel{deepblue}{THEOREM \thetheorem}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}
\NewDocumentEnvironment{theorem}{O{}}{\refstepcounter{theorem}\begin{theorembox}{#1}}{\end{theorembox}}
\newenvironment{proof}[1][Proof]{\par\smallskip\noindent{\sffamily\small\bfseries #1.}\enspace}
  {\unskip\nobreak\hfill\rule{0.45em}{0.45em}\par\smallskip}
% The identity matrix (not $I$, which is the integral term)
\newcommand{\Id}{\symbb{1}}
% A state vector
\newcommand{\vx}{\symbf{x}}

% Where this leads — the thread from a lesson into the later parts of the course
\newtcolorbox{lookahead}[1][]{base, frame hidden, colback=bluesoft, arc=3pt, left=12pt, right=12pt, top=9pt, bottom=9pt,
  title={\boxlabel{deepblue}{WHERE THIS LEADS}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}

% In Anemostatos — styled like the app itself
\newcommand{\appmark}{\tikz[baseline=-0.1em]{\draw[accent, line width=1.2pt, line cap=round] (0,0)--(0.62em,0.62em) (0,0.62em)--(0.62em,0);}}
\newtcolorbox{inapp}[1][]{base, whole, colback=night, colupper=nighttext, coltitle=nighttext, arc=3pt,
  fontupper={\sffamily\small\linespread{1.18}\selectfont\raggedright},
  title={\appmark\hspace{0.5em}\boxlabel{nightmuted}{IN ANEMOSTATOS}\ifstrempty{#1}{}{\hspace{0.8em}{\color{nighttext}\sffamily\small\bfseries #1}}},
  attach title to upper, after title={\par\smallskip},
  before upper app={\let\src\srcnight\let\param\paramnight\let\ui\uinight\let\key\keynight}}

% Try this — the app's own orange-bordered box
\newtcolorbox{trythis}[1][]{base, whole, colback=accentsoft!55, colframe=accent, boxrule=0.7pt, arc=3pt,
  title={\boxlabel{accent}{TRY THIS}\ifstrempty{#1}{}{\hspace{0.8em}{\sffamily\small\bfseries #1}}},
  attach title to upper, flushfirst}
\newcommand{\predict}[1]{\par\smallskip\noindent{\color{accent}\sffamily\small\bfseries Predict first.}\enspace\textit{#1}\par\smallskip}

% What to remember
\newtcolorbox{remember}{base, frame hidden, colback=mist, arc=3pt, left=12pt, right=12pt, top=9pt, bottom=9pt,
  title={\boxlabel{ink}{WHAT TO REMEMBER}}, attach title to upper, flushfirstmed,
  before upper app={\setlist[itemize]{label={\tickmark}, leftmargin=1.3em}}}
% Drawn, because the math font has no U+2713.
\newcommand{\tickmark}{\tikz[baseline=-0.05em]{\draw[sigI, line width=0.9pt, line cap=round, line join=round] (0,0.22em)--(0.22em,0)--(0.62em,0.52em);}}

% Out in the world — the curiosity pages
% The story is a float: it takes the head of the next page (or a page of its own when it is long)
% and the text flows on around it, so it never leaves a hole behind it.
\NewDocumentEnvironment{curiosity}{m +b}{%
  \suppressfloats[t]%
  \begin{figure}[tp]\noindent\makebox[\textwidth][l]{\begin{minipage}{\fullwidthlen}%
    \begin{curiositybox}{#1}#2\end{curiositybox}\end{minipage}}\end{figure}}{}
\newtcolorbox{curiositybox}[1]{enhanced, colback=paper, boxrule=0pt, arc=0pt,
  left=14pt, right=14pt, top=12pt, bottom=12pt, before skip=0pt, after skip=0pt,
  fontupper={\normalsize},
  title={\boxlabel{sepia}{OUT IN THE WORLD}\par\smallskip{\displayserif\fontsize{19}{23}\selectfont\color{ink}#1}},
  attach title to upper, after title={\par\medskip},
  before upper app={\setlength{\parindent}{0pt}\setlength{\parskip}{5pt plus 1pt}},
  borderline north={0.6pt}{0pt}{sepia!60}}
\newcommand{\photo}[3][]{% [options] {key} {caption}
  \par\medskip\noindent\begin{minipage}{\linewidth}
    \includegraphics[width=\linewidth,#1]{photos/#2}\par\vspace{3pt}
    {\sffamily\scriptsize\color{sepia}#3\hfill\hyperref[credit:#2]{\textsc{photo credit}}}
  \end{minipage}\par\medskip}
\newcommand{\photopair}[5]{% {key1}{caption1}{key2}{caption2}{height}
  \par\medskip\noindent
  \begin{minipage}[t]{0.49\linewidth}\includegraphics[height=#5,width=\linewidth,keepaspectratio]{photos/#1}\par\vspace{2pt}{\sffamily\scriptsize\color{sepia}#2 \hyperref[credit:#1]{\textsc{credit}}}\end{minipage}\hfill
  \begin{minipage}[t]{0.49\linewidth}\includegraphics[height=#5,width=\linewidth,keepaspectratio]{photos/#3}\par\vspace{2pt}{\sffamily\scriptsize\color{sepia}#4 \hyperref[credit:#3]{\textsc{credit}}}\end{minipage}\par\medskip}
% a photo placed at the side of the curiosity text
\newcommand{\sidephoto}[3]{% {key}{width}{caption}
  \begin{wrapfigure}{r}{#2}\vspace{-6pt}\includegraphics[width=#2]{photos/#1}\par\vspace{2pt}
  {\sffamily\scriptsize\color{sepia}\raggedright #3 \hyperref[credit:#1]{\textsc{credit}}\par}\vspace{-8pt}\end{wrapfigure}}

% Keep a box title with its first lines. Not \needspace: with \raggedbottom every page has
% badness 10000 for TeX's page builder, and the stretch that \needspace adds makes the break in
% front of a box the only one with a finite cost, so the page ends there even when the box fits.
\newcommand{\keeptogether}[1]{\par\begingroup
  \dimen@=\dimexpr#1\relax
  \dimen@ii=\dimexpr\pagegoal-\pagetotal\relax
  % Only when the space left is positive: right after a paragraph the page may still be
  % overfull (its last line is no legal breakpoint), and TeX will carry that tail over by itself.
  \ifdim\dimen@ii>\z@ \ifdim\dimen@>\dimen@ii \break \fi\fi
  \endgroup}
\BeforeBeginEnvironment{definition}{\keeptogether{5\baselineskip}}
\BeforeBeginEnvironment{example}{\keeptogether{6\baselineskip}}
\BeforeBeginEnvironment{theorem}{\keeptogether{6\baselineskip}}
\BeforeBeginEnvironment{lookahead}{\keeptogether{6\baselineskip}}
\BeforeBeginEnvironment{remember}{\keeptogether{9\baselineskip}}

