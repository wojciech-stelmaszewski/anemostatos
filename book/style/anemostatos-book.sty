  \begin{list}{}{\setlength{\leftmargin}{2.6em}\setlength{\labelwidth}{2.4em}\setlength{\itemsep}{5pt}}}
  {\end{list}}
\newcommand{\exercise}[1][1]{\refstepcounter{exercise}\item[{\sffamily\small\color{accent}\theexercise}\,%
  {\color{faint}\ifcase#1\or\raisebox{0.2ex}{\tiny$\bullet$}\or\raisebox{0.2ex}{\tiny$\bullet\bullet$}\or\raisebox{0.2ex}{\tiny$\bullet\bullet\bullet$}\fi}]}
% The kind of an exercise: derive (pencil and paper), fly (in the simulator), code (against the source)
\newcommand{\exkind}[1]{{\sanscaps\scriptsize\color{deepblue}#1}\enspace}
% answers collected for the appendix
\newwrite\answersfile
\immediate\openout\answersfile=\jobname.ans
\newcommand{\answer}[1]{\immediate\write\answersfile{\string\answeritem{\theexercise}{\unexpanded{#1}}}}
\newcommand{\answeritem}[2]{\par\noindent\hangindent=3.2em\makebox[3.2em][l]{\sffamily\small\color{accent}#1}#2\par\smallskip}
\newcommand{\closeanswers}{\immediate\closeout\answersfile}

