% ---------------------------------------------------------------- the night scene
% A perspective floor grid like the simulator's, used on openers and the cover.
% #1 = height of the band, #2 = horizon position (fraction of height from top)
\newcommand{\nightgrid}[2]{%
  \fill[night] (0,0) rectangle (\paperwidth,-#1);
  \shade[top color=night, bottom color=nightsky] (0,0) rectangle (\paperwidth,-#2*#1);
  \begin{scope}
    \clip (0,-#2*#1) rectangle (\paperwidth,-#1);
    \pgfmathsetmacro{\hy}{-#2*#1/1cm}
    \pgfmathsetmacro{\by}{-#1/1cm}
    \pgfmathsetmacro{\cx}{0.62*\paperwidth/1cm}
    \foreach \i in {-40,...,40} {
      \pgfmathsetmacro{\xb}{\cx+\i*2.1}
      \draw[gridminor, line width=0.35pt] (\cx,\hy) -- (\xb,\by-6);
    }
    \foreach \k in {1,...,26} {
      \pgfmathsetmacro{\yy}{\hy+(\by-\hy-6)*(1/(1+0.33*(26-\k)))}
      \draw[gridmajor, line width={0.2pt+0.02pt*\k}] (0,\yy) -- (\paperwidth,\yy);
    }
    \shade[top color=nightsky, bottom color=nightsky, middle color=nightsky, opacity=0.0] (0,\hy) rectangle (\paperwidth,\hy-0.3);
    \fill[nightsky, path fading=south] (0,\hy) rectangle (\paperwidth,\hy-1.6);
  \end{scope}
}

% ---------------------------------------------------------------- lesson opener
% \lesson{label}{title}{subtitle}{level}{app id}{part tag}
\newcommand{\lessonlevelname}[1]{%
  \ifstrequal{#1}{1}{L1 · altitude}{\ifstrequal{#1}{2}{L2 · point mass}{\ifstrequal{#1}{3}{L3 · quadrotor}{#1}}}}
\newcommand{\lesson}[6]{%
  \clearpage
  \refstepcounter{chapter}%
  \renewcommand{\lessonlabel}{#1}%
  \renewcommand{\lessontitle}{#2}%
  \renewcommand{\lessonpart}{#6}%
  \setcounter{section}{0}\setcounter{equation}{0}\setcounter{figure}{0}\setcounter{table}{0}%
  \setcounter{sidenote}{0}%
  \protected@edef\@currentlabel{#1}%
  \addcontentsline{toc}{chapter}{\protect\numberline{#1}#2}%
  \markboth{#2}{#2}%
  \thispagestyle{plain}%
  \begin{tikzpicture}[remember picture, overlay, shift={(current page.north west)}]
    \nightgrid{88mm}{0.62}
    % a soft glow where the drone would hover
    \shade[inner color=accent!55!night, outer color=night, opacity=0.35]
      ($(0.72\paperwidth,-46mm)$) circle (30mm);
    \node[anchor=north west, inner sep=0pt, text=nightmuted] at (24mm,-19mm)
      {\sanscaps\footnotesize LESSON\hspace{1.2em}\color{accent}\lessonlevelname{#4}};
    \node[anchor=north west, inner sep=0pt, text=accent] at (22.5mm,-27mm)
      {\sansthin\fontsize{64}{64}\selectfont #1};
    \node[anchor=south west, inner sep=0pt, text=nighttext, inner sep=0pt] at (24mm,-72mm)
      {\parbox[b]{150mm}{\raggedright\sansdisplay\fontsize{28}{32}\selectfont #2}};
    \node[anchor=north west, inner sep=0pt, text=nightmuted, inner sep=0pt] at (24mm,-76mm)
      {\parbox[t]{150mm}{\raggedright\displayserif\itshape\fontsize{12.5}{15}\selectfont #3}};
    \node[anchor=north east, inner sep=0pt, text=nightmuted] at ($(\paperwidth-14mm,-19mm)$)
      {\ttfamily\footnotesize\color{nightmuted}lesson id \color{accent}'#5'};
  \end{tikzpicture}%
  \vspace*{73mm}%
  \@afterindentfalse\@afterheading
}

% A lesson-free chapter (preface, prelude, appendices) with the same opener.
\newcommand{\bookchapter}[3]{% {toc label}{title}{subtitle}
  \clearpage
  \refstepcounter{chapter}%
  \renewcommand{\lessonlabel}{#1}%
  \renewcommand{\lessontitle}{#2}%
  \renewcommand{\lessonpart}{}%
  \setcounter{section}{0}\setcounter{equation}{0}\setcounter{figure}{0}\setcounter{table}{0}%
  \protected@edef\@currentlabel{#1}%
  \ifstrempty{#1}{\addcontentsline{toc}{chapter}{#2}}{\addcontentsline{toc}{chapter}{\protect\numberline{#1}#2}}%
  \markboth{#2}{#2}%
  \thispagestyle{plain}%
  \begin{tikzpicture}[remember picture, overlay, shift={(current page.north west)}]
    \nightgrid{70mm}{0.66}
    \node[anchor=south west, inner sep=0pt, text=nighttext, inner sep=0pt] at (24mm,-52mm)
      {\parbox[b]{160mm}{\raggedright\sansdisplay\fontsize{28}{32}\selectfont #2}};
    \node[anchor=north west, inner sep=0pt, text=nightmuted, inner sep=0pt] at (24mm,-56mm)
      {\parbox[t]{160mm}{\raggedright\displayserif\itshape\fontsize{12.5}{15}\selectfont #3}};
    \ifstrempty{#1}{}{\node[anchor=north west, inner sep=0pt, text=accent] at (24mm,-17mm)
      {\sansthin\fontsize{40}{40}\selectfont #1};}
  \end{tikzpicture}%
  \vspace*{55mm}%
  \@afterindentfalse\@afterheading
}

% ---------------------------------------------------------------- part pages
\newcommand{\bookpart}[4]{% {numeral}{title}{epigraph}{intro}
  \clearpage
  \thispagestyle{empty}%
  \renewcommand{\lessontitle}{}\renewcommand{\lessonpart}{}%
  \addcontentsline{toc}{part}{\protect\numberline{#1}#2}%
  \begin{tikzpicture}[remember picture, overlay, shift={(current page.north west)}]
    \nightgrid{\paperheight}{0.52}
    \shade[inner color=accent!60!night, outer color=night, opacity=0.35]
      ($(0.62\paperwidth,-0.47\paperheight)$) circle (45mm);
    \node[anchor=north west, text=nightmuted, inner sep=0pt] at (24mm,-40mm) {\sanscaps\small PART};
    \node[anchor=north west, text=accent, inner sep=0pt] at (21mm,-47mm)
      {\displayserif\fontsize{120}{120}\selectfont #1};
    \node[anchor=north west, text=nighttext, inner sep=0pt] at (24mm,-100mm)
      {\parbox[t]{165mm}{\raggedright\sansdisplay\fontsize{38}{44}\selectfont #2}};
    \node[anchor=north west, text=nightmuted, inner sep=0pt] at (24mm,-128mm)
      {\parbox[t]{120mm}{\raggedright\displayserif\itshape\fontsize{13}{17}\selectfont #3}};
    \node[anchor=south west, text=nighttext, inner sep=0pt] at (24mm,-280mm)
      {\parbox[b]{150mm}{\raggedright\sffamily\small\color{nightmuted}#4}};
  \end{tikzpicture}%
  \null\clearpage
}

% Part II's five chapters (A–E): a light divider page
\newcommand{\movement}[3]{% {letter}{title}{text}
  \clearpage
  \thispagestyle{empty}%
  \renewcommand{\lessontitle}{}\renewcommand{\lessonpart}{}%
  \addcontentsline{toc}{section}{#1\quad #2}%
  \begin{tikzpicture}[remember picture, overlay, shift={(current page.north west)}]
    \fill[mist] (0,0) rectangle (\paperwidth,-\paperheight);
    \node[anchor=north west, text=accent!22, inner sep=0pt] at (14mm,-18mm)
      {\sansthin\fontsize{260}{260}\selectfont #1};
    \node[anchor=north west, text=muted, inner sep=0pt] at (24mm,-112mm) {\sanscaps\small CHAPTER #1 OF PART II};
    \node[anchor=north west, text=ink, inner sep=0pt] at (24mm,-120mm)
      {\parbox[t]{160mm}{\raggedright\sansdisplay\fontsize{30}{36}\selectfont #2}};
    \node[anchor=north west, text=ink, inner sep=0pt] at (24mm,-146mm)
      {\parbox[t]{124mm}{\normalsize #3}};
  \end{tikzpicture}%
  \null\clearpage
}

